+    private function slaStageStartedAt(MarketplaceOrder $order): ?Carbon
+    {
+        $explicit = match ($order->status) {
+            'new' => $order->created_at,
+            'ready_for_pickup' => $order->ready_at,
+            'courier_accepted' => $order->accepted_at,
+            'heading_pickup' => $order->pickup_started_at,
+            'arrived_pickup' => $order->arrived_pickup_at,
+            'in_transit' => $order->picked_up_at,
+            'arrived_buyer' => $order->arrived_buyer_at,
+            default => null,
+        };
+
+        if ($explicit) {
+            return Carbon::instance($explicit);
+        }
+
+        $event = $order->events
+            ->first(fn ($candidate) =>
+                (string) $candidate->status === (string) $order->status
+                || (string) $candidate->type === (string) $order->status
+            );
+
+        if ($event?->created_at) {
+            return Carbon::instance($event->created_at);
+        }
+
+        return $order->updated_at
+            ? Carbon::instance($order->updated_at)
+            : ($order->created_at ? Carbon::instance($order->created_at) : null);
