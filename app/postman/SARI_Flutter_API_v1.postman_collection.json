    {
      "name": "Mobile Auth",
      "item": [
        {
          "name": "Login (buyer example)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "description": "Set role=buyer/seller/rider/logistics. Password social accounts not supported.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"buyer\",\n  \"email\": \"buyer@example.org\",\n  \"password\": \"REPLACE_ME\",\n  \"device_name\": \"Android Test Device\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me",
            "description": ""
          },
          "response": []
        },
        {
          "name": "Logout this device",
          "request": {
